    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
